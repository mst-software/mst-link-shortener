APP_NAME=LinkCash
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

SEPAY_API_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# Reverse proxies whose X-Forwarded-* headers are trusted (config/trustedproxy.php).
# Empty = none (visitors connect straight to PHP). "cloudflare" = Cloudflare's ranges,
# "*" = whichever server connects, or a comma-separated list of IPs/CIDRs.
TRUSTED_PROXIES=
# Read the visitor country from CF-IPCountry (only on requests from a Cloudflare edge).
# Leave empty to turn it on exactly when TRUSTED_PROXIES contains "cloudflare".
TRUST_COUNTRY_HEADER=

# Where `php artisan db:backup` writes dumps (default storage/app/backups).
# DB_BACKUP_PATH=

# ---------------------------------------------------------------------------
# PRODUCTION
# The values above are local development defaults. On the live server change
# at least the following (then run `php artisan app:preflight`):
#
# APP_ENV=production
# APP_DEBUG=false                 # never true in production: errors would show stack traces
# APP_URL=https://your-domain     # https only; used in emails and the widget snippet
# APP_KEY=                        # generate once with `php artisan key:generate`, then keep it:
#                                 # it encrypts the secrets saved in the admin settings
# LOG_LEVEL=warning
#
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=linkcash
# DB_USERNAME=linkcash
# DB_PASSWORD=
#
# SESSION_DRIVER=database         # or redis
# SESSION_SECURE_COOKIE=true      # session cookie only over https
# CACHE_STORE=database            # or redis
# QUEUE_CONNECTION=database       # or redis; needs a `php artisan queue:work` process
#
# TRUSTED_PROXIES=cloudflare      # when the site is behind Cloudflare
#
# MAIL_*: SMTP is normally set on the admin Email settings page, which overrides
# these values once saved. Keep MAIL_MAILER=smtp here only if you prefer .env.
# Captcha, PayPal (switch PAYPAL_MODE=live) and SePay keys can also be set on
# the admin settings pages instead of here.
# After changing mail or payment settings run `php artisan queue:restart`.
# ---------------------------------------------------------------------------
